 import AppKit
 
+/// Tracks only the host windows that contain an embedded cmux workspace.
+/// Weak references avoid extending a SwiftUI window's lifetime.
+@MainActor
+enum CmuxEmbeddedWindowDragPolicy {
+    private static let windows = NSHashTable<NSWindow>.weakObjects()
+
+    static func markEmbedded(_ window: NSWindow) {
+        windows.add(window)
+    }
+
+    static func unmarkEmbedded(_ window: NSWindow) {
+        windows.remove(window)
+    }
+
+    static func isEmbedded(_ window: NSWindow) -> Bool {
+        windows.contains(window)
+    }
+}
