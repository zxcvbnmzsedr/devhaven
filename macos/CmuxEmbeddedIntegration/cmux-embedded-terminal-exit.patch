+
+/// Embedded hosts have no cmux AppDelegate. Resolve terminal callbacks by the
+/// owning workspace ID, including background workspaces, without retaining hosts.
+@MainActor
+enum EmbeddedTerminalOwnerRegistry {
+    static let managers = NSHashTable<TabManager>.weakObjects()
+
+    static func manager(for workspaceId: UUID) -> TabManager? {
+        managers.allObjects.first {
+            $0.isEmbeddedInHost && !$0.isFinalizedForWindowClose &&
+                $0.workspacesById[workspaceId] != nil
+        }
+    }
+}
