+
+/// Shared by ingress, async hook resolution and final delivery. Embedded hosts
+/// have no cmux AppDelegate; standalone cmux keeps its existing owner resolver.
+@MainActor
+enum TerminalNotificationOwnerRouting {
+    static func manager(for tabId: UUID) -> TabManager? {
+        EmbeddedTerminalOwnerRegistry.manager(for: tabId)
+            ?? AppDelegate.shared?.tabManagerFor(tabId: tabId)
+            ?? AppDelegate.shared?.tabManager
+    }
+
+    static func target(claimedTabId: UUID?, surfaceId: UUID?) -> (tabId: UUID, surfaceId: UUID?)? {
+        if let surfaceId {
+            // Resolve again after asynchronous hooks: panes may move or close.
+            for manager in EmbeddedTerminalOwnerRegistry.managers.allObjects
+                where manager.isEmbeddedInHost && !manager.isFinalizedForWindowClose {
+                for workspace in manager.tabs {
+                    if let owner = workspace.surfaceOwnershipTarget(for: surfaceId) {
+                        return (workspace.id, owner.surfaceID)
+                    }
+                }
+            }
+        } else if let claimedTabId,
+                  EmbeddedTerminalOwnerRegistry.manager(for: claimedTabId) != nil {
+            return (claimedTabId, nil)
+        }
+        return AppDelegate.shared?.agentNotificationDeliveryTarget(
+            claimedTabId: claimedTabId, surfaceId: surfaceId
+        )
+    }
+}
