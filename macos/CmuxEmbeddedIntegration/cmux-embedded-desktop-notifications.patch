+            let window = view?.window
+            let ownsFocus = NSApp.isActive && window?.isKeyWindow == true
+                && window?.attachedSheet == nil
+                && view?.isHiddenOrHasHiddenAncestor == false
+                && view?.isSurfaceViewFirstResponder() == true
+            return NotificationFocusState(
+                isAppFocused: ownsFocus,
+                isActiveTab: manager.selectedTabId == tabId,
+                isFocusedSurface: surfaceId == nil || focusedSurfaceId == surfaceId,
+                workspace: workspace,
+                cmuxConfigStore: nil
+            )
+        }
